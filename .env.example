# AI providers (researcher only — participants never see these)
# VITE_OPENAI_API_KEY=
# VITE_ANTHROPIC_API_KEY=
# VITE_GOOGLE_API_KEY=

# Post-session Qualtrics post-reflection survey.
# {participantId} → Qualtrics ResponseID from ?pid= param
# {condition}     → raw Qualtrics condition value: standard or explorer
# Example:
# VITE_POST_SURVEY_URL=https://your-school.qualtrics.com/jfe/form/SV_abc123?pid={participantId}&cond={condition}
VITE_POST_SURVEY_URL=

# Where session JSON logs are POSTed on completion (see docs/SETUP-GOOGLE-SHEET.md).
# Google Apps Script web app URL, Supabase REST endpoint, or your own API.
VITE_RECORD_SUBMIT_URL=

# Optional shared secret sent as ?token= query param (Google Apps Script)
# and/or Authorization: Bearer <token> header (other APIs).
# VITE_RECORD_SUBMIT_TOKEN=
